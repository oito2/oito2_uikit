{
	"name": "@oito2/ui-test-utils",
	"version": "0.0.0",
	"description": "Test helpers shared by the @oito2/ui packages; not published.",
	"license": "GPL-3.0-only",
	"author": "OITO2",
	"private": true,
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "svelte-package",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run"
	},
	"peerDependencies": {
		"svelte": "^5.57.0"
	},
	"devDependencies": {
		"@sveltejs/package": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"playwright": "catalog:",
		"publint": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "catalog:"
	}
}
