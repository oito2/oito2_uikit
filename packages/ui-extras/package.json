{
	"name": "@oito2/ui-extras",
	"version": "0.1.0",
	"description": "Optional @oito2/ui components with heavier or niche needs: QR codes, a signature pad, an image cropper and a website-style navigation menu.",
	"license": "GPL-3.0-only",
	"author": "OITO2",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oito2/oito2_uikit.git",
		"directory": "packages/ui-extras"
	},
	"homepage": "https://github.com/oito2/oito2_uikit#readme",
	"bugs": {
		"url": "https://github.com/oito2/oito2_uikit/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"tauri",
		"design-system",
		"desktop"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/__screenshots__"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "svelte-package && publint",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@oito2/ui": "workspace:^",
		"svelte": "^5.57.0"
	},
	"dependencies": {
		"@lucide/svelte": "catalog:",
		"qrcode-generator": "catalog:"
	},
	"devDependencies": {
		"@oito2/ui": "workspace:*",
		"@oito2/ui-test-utils": "workspace:*",
		"@sveltejs/package": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"axe-core": "catalog:",
		"jsqr": "catalog:",
		"playwright": "catalog:",
		"publint": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "catalog:"
	}
}
