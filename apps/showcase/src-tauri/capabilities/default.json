{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main-capability",
	"description": "Main window: core defaults, the window actions of the custom title bar, the file chooser, Save as dialog and file reads and writes of the file components, and opening the project's GitHub pages in the system browser.",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-close",
		"core:window:allow-start-dragging",
		"core:window:allow-start-resize-dragging",
		"oito2-window:default",
		"oito2-settings:default",
		"dialog:allow-open",
		"dialog:allow-save",
		"fs:allow-stat",
		"fs:allow-read-file",
		"fs:allow-write-file",
		{
			"identifier": "opener:allow-open-url",
			"allow": [{ "url": "https://github.com/oito2/*" }]
		}
	]
}
