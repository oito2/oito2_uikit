{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "oito2_uikit Showcase",
	"mainBinaryName": "oito2-uikit-showcase",
	"version": "0.1.0",
	"identifier": "io.github.oito2.uikit-showcase",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "oito2_uikit Showcase",
				"width": 1100,
				"height": 760,
				"minWidth": 360,
				"minHeight": 300,
				"resizable": true,
				"visible": false
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"connect-src": "ipc: http://ipc.localhost",
				"img-src": "'self' data: blob:",
				"font-src": "'self' data:",
				"style-src": "'self' 'unsafe-inline'"
			},
			"devCsp": null,
			"freezePrototype": true
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
