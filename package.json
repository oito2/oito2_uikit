{
	"name": "oito2_uikit",
	"private": true,
	"type": "module",
	"description": "Workspace root for the oito2_uikit Svelte packages, Tauri plugins and the showcase app.",
	"license": "GPL-3.0-only",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm -r build",
		"check": "pnpm -r --parallel check",
		"test": "pnpm -r test",
		"test:tools": "node --test \"tools/**/*.test.ts\"",
		"lint": "prettier --check . && eslint . && node tools/lint-headers/check.ts",
		"lint:headers": "node tools/lint-headers/check.ts",
		"format": "prettier --write .",
		"generate": "node tools/generate-css/generate.ts",
		"generate:check": "node tools/generate-css/generate.ts --check",
		"docs:generate": "node tools/generate-docs/generate.ts",
		"docs:check": "node tools/generate-docs/generate.ts --check",
		"showcase": "pnpm --filter @oito2/showcase",
		"tauri": "pnpm --filter @oito2/showcase tauri",
		"changeset": "changeset",
		"release:version": "changeset version && node tools/release/sync-versions.ts && prettier --write \"**/CHANGELOG.md\"",
		"release:check": "node tools/release/sync-versions.ts --check"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"@eslint/js": "catalog:",
		"@types/node": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"globals": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:",
		"svelte": "catalog:",
		"svelte2tsx": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:"
	}
}
